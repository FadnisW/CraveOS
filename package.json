{
  "name": "eatclub-web",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "next dev --turbopack --port 3000",
    "build": "next build",
    "build:api": "npm --prefix apps/api run build",
    "start": "next start --port 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "typecheck:api": "npm --prefix apps/api run typecheck",
    "check:no-fakes": "node scripts/check-no-fakes.mjs",
    "check:api-health": "node scripts/check-api-health.mjs",
    "check:prod-guard": "node scripts/check-production-guard.mjs",
    "verify": "npm run check:no-fakes && npm run typecheck && npm run typecheck:api && npm run build && npm run build:api",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:seed": "prisma db seed",
    "db:seed:prod": "tsx prisma/seed.prod.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^0.475.0",
    "motion": "^12.43.0",
    "next": "^16.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io-client": "^4.7.5"
  },
  "devDependencies": {
    "@prisma/client": "5.22.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "prisma": "5.22.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.11",
    "typescript": "^5.9.3"
  }
}
