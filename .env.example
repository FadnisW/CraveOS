# Copy to .env and fill in real values. Never commit .env.
#
# Production startup guard (apps/api/src/common/config/env.validation.ts):
#   - DATABASE_URL and REDIS_URL are required in every environment.
#   - JWT_SECRET is required; in production it must be >= 32 characters and
#     must not look like an example value.
#   - DEV_OTP_BYPASS must be false/absent when NODE_ENV=production.
#   - NEXT_PUBLIC_APP_URL must list explicit HTTPS origins in production.
# The API exits before listening when any of these are violated.

DATABASE_URL="postgresql://postgres:password@localhost:5432/craveos?schema=public"
REDIS_URL="redis://localhost:6379"
NODE_ENV="development"
PORT="4000"

# Required — the API refuses to start without it. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string"

# Local-only OTP bypass (code 123456). Leave false/absent in production.
DEV_OTP_BYPASS="false"

# Razorpay (use test keys locally)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Resend
RESEND_API_KEY=""
# Must be a verified domain sender in production. The shared
# onboarding@resend.dev sender only delivers to the Resend account owner.
RESEND_FROM_EMAIL=""
DEV_EMAIL_RECIPIENT="delivered@resend.dev"

# Production bootstrap (npm run db:seed:prod). Creates the first super-admin
# and nothing else. Never put demo credentials in a production database.
SUPER_ADMIN_EMAIL=""
SUPER_ADMIN_PHONE=""
SUPER_ADMIN_NAME=""

# Public app origin(s) used for REST and WebSocket CORS. Comma-separated.
# Development adds http://localhost:3000 automatically.
# Production example: https://app.example.com,https://admin.example.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Server-only API origin used by the Next BFF (app/api/bff/[...path]/route.ts).
# Never expose this to the browser. Include /api/v1 or let the BFF append it.
API_INTERNAL_URL="http://localhost:4000/api/v1"

# Browser WebSocket origin for live order updates. Required in production;
# development falls back to http://localhost:4000. Next route handlers cannot
# proxy a WebSocket upgrade, so the browser connects to the API directly.
NEXT_PUBLIC_SOCKET_URL="http://localhost:4000"

# Legal and support identity. These values are rendered on the Terms, Privacy,
# Refund, Delivery and Contact pages and in the storefront footer.
#
# `npm run check:legal` is advisory and lists what is missing.
# `npm run check:legal:release` exits 1 until every value is real, and the
# release workflow runs it before building. Do not put a placeholder or an
# invented value here: the pages are a contract with the customer.
NEXT_PUBLIC_LEGAL_ENTITY_NAME=""
NEXT_PUBLIC_LEGAL_REGISTERED_ADDRESS=""
NEXT_PUBLIC_LEGAL_JURISDICTION=""
NEXT_PUBLIC_LEGAL_FSSAI_LICENCE=""
NEXT_PUBLIC_LEGAL_GSTIN=""
NEXT_PUBLIC_SUPPORT_EMAIL=""
NEXT_PUBLIC_SUPPORT_PHONE=""
NEXT_PUBLIC_GRIEVANCE_OFFICER_NAME=""
NEXT_PUBLIC_GRIEVANCE_OFFICER_EMAIL=""
NEXT_PUBLIC_GRIEVANCE_OFFICER_PHONE=""

# Trusted reverse-proxy hops in front of the API. Leave 0 when the API is
# directly exposed; set 1 behind a proxy so OTP per-IP limits read the
# X-Forwarded-For address instead of the proxy's address.
TRUST_PROXY="0"
